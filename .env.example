# Copy this file to .env and fill in the keys you have. Never commit .env.
# Every key is optional: missing keys disable only the features that need them.

# --- AI provider (CV interpretation, extraction assistance, semantic matching) ---
AI_PROVIDER=gemini
# Leave empty to auto-select the newest stable Gemini Flash model via the models.list API.
AI_MODEL=
GEMINI_API_KEY=

# --- Web search provider (search engine, job portal, social media, community discovery) ---
# Supported: brave   (https://api-dashboard.search.brave.com)
SEARCH_PROVIDER=brave
SEARCH_API_KEY=

# Optional second provider used when the first fails or its budget is exhausted.
SECONDARY_SEARCH_PROVIDER=
SECONDARY_SEARCH_API_KEY=

# --- Optional platform APIs ---
# Reddit "application only" OAuth (https://www.reddit.com/prefs/apps, type "script" or "web app")
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# X API v2 recent search (paid access tier required)
X_BEARER_TOKEN=

# --- Gmail (application e-mails) ---
# OAuth "Desktop app" client JSON downloaded from Google Cloud Console, and where the token is stored.
# Both default to data/secrets/ (git-ignored). Never commit these files.
GMAIL_CLIENT_SECRET_FILE=
GMAIL_TOKEN_FILE=
# The Gmail address you send from (used as the From address).
GMAIL_SENDER_ADDRESS=
# Alternative to OAuth when you cannot create a Google Cloud project: a Gmail App Password
# (https://myaccount.google.com/apppasswords, needs 2-Step Verification). When set, e-mails go
# through smtp.gmail.com. It grants FULL account access: keep it only here, never share it.
GMAIL_APP_PASSWORD=

# --- Applicant details (optional; otherwise taken from the CV header) ---
APPLICANT_NAME=
APPLICANT_EMAIL=
APPLICANT_PHONE=
APPLICANT_LOCATION=
# Comma-separated, e.g. linkedin.com/in/you,github.com/you
APPLICANT_LINKS=

# Set to 1 to run network-dependent tests: pytest -m live
RUN_LIVE_TESTS=0

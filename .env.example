# Copy this file to .env and fill in the keys you have. Never commit .env.
# Every key is optional: missing keys disable only the features that need them.

# --- AI provider (CV interpretation, extraction assistance, semantic matching) ---
AI_PROVIDER=gemini
# Leave empty to auto-select the newest stable Gemini Flash model via the models.list API.
AI_MODEL=
GEMINI_API_KEY=

# --- Web search provider (search engine, job portal, social media, community discovery) ---
# Supported: brave   (https://api-dashboard.search.brave.com)
SEARCH_PROVIDER=brave
SEARCH_API_KEY=

# Optional second provider used when the first fails or its budget is exhausted.
SECONDARY_SEARCH_PROVIDER=
SECONDARY_SEARCH_API_KEY=

# --- Optional platform APIs ---
# Reddit "application only" OAuth (https://www.reddit.com/prefs/apps, type "script" or "web app")
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# X API v2 recent search (paid access tier required)
X_BEARER_TOKEN=

# Set to 1 to run network-dependent tests: pytest -m live
RUN_LIVE_TESTS=0
